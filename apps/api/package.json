{
  "name": "@bozorchi/api",
  "version": "1.0.0",
  "description": "Backend API for Bozorchi",
  "main": "dist/app.js",
  "type": "module",
  "trustedDependencies": [
    "prisma"
  ],
  "scripts": {
    "dev": "bun --watch --env-file=.env.development app.ts",
    "build": "bun run generate:api && tsc && tsc-alias",
    "generate:api": "bun run generate:public && bun run generate:tenant",
    "generate:public": "bunx prisma generate --schema=prisma/schema/public.prisma",
    "generate:tenant": "bunx prisma generate --schema=prisma/tenant/schema.prisma",
    "generate:all": "bun run generate:api",
    "start": "bun --env-file=.env.production app.ts",
    "test": "jest",
    "test:int": "NODE_ENV=test bun --env-file=.env.development test tests/integration",
    "test:unit": "NODE_ENV=test bun test tests/unit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "seed:basic": "dotenv -e .env.development -- ts-node scripts/seed.ts",
    "preinstall": "echo 'Installing with Bun'",
    "postinstall": "bun run generate:api",
    "seed:production": "dotenv -e .env -- tsx scripts/seed/index.ts"
  },
  "keywords": [
    "api",
    "backend",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.3",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@polar-sh/sdk": "^0.41.5",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^7.3.0",
    "@prisma/client-runtime-utils": "^7.3.0",
    "@prisma/instrumentation": "^7.2.0",
    "@types/bwip-js": "^3.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/minio": "^7.1.1",
    "@types/mocha": "^10.0.10",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.69.1",
    "bwip-js": "^4.8.0",
    "compression": "^1.8.1",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.2.4",
    "minio": "^8.0.6",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "prisma-erd-generator": "^2.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redlock": "^5.0.0-beta.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "winston-loki": "^6.1.3",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.5",
    "@types/compression": "^1.8.1",
    "@types/connect-timeout": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^25.0.2",
