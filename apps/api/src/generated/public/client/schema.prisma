generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/public/client"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  subscription_id      String?
  subscription_status  SubscriptionStatus? @default(incomplete)
  subscription_ends_at DateTime?
  owner_id             String              @unique
  owner                User                @relation("OrgOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  members              UserOrganization[]
  invites              StoreInvite[]

  // Uzum FastPay Configuration
  uzum_fastpay_enabled                  Boolean @default(false)
  uzum_fastpay_merchant_id              String?
  uzum_fastpay_secret_key               String? // Encrypted
  uzum_fastpay_service_id               String?
  uzum_fastpay_merchant_service_user_id String?

  // E-commerce Configuration
  ecommerce_enabled Boolean @default(false)

  @@map("organizations")
}

model User {
  id                    String               @id @default(cuid())
  name                  String?
  email                 String               @unique
  password_hash         String?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  push_token            String?
  owned_organization    Organization?        @relation("OrgOwner")
  mobile_push_tokens    MobilePushToken[]
  password_reset_tokens PasswordResetToken[]
  auth_identities       UserAuthIdentity[]

  @@map("users")
}

model UserAuthIdentity {
  id               String   @id @default(cuid())
  user_id          String
  provider         String
  provider_user_id String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id])
  @@map("user_auth_identities")
}

model MobilePushToken {
  id           String   @id @default(cuid())
  user_id      String
  token        String   @unique
  platform     String
  provider     String
  device_name  String?
  app_version  String?
  build_number String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  last_seen_at DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([platform])
  @@map("mobile_push_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  token_hash String    @unique
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([token_hash])
  @@index([user_id])
  @@map("password_reset_tokens")
}

model UserOrganization {
  id              String       @id @default(cuid())
  user_id         String       @unique
  organization_id String
  store_id        String
  role            Role         @default(user)
  permissions     Permission[]
  approved        Boolean      @default(false)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([user_id, organization_id, store_id])
  @@index([user_id])
  @@index([organization_id])
  @@index([store_id])
  @@map("user_organizations")
}

model StoreInvite {
  id              String       @id @default(cuid())
  organization_id String
  store_id        String
  token_hash      String       @unique
  expires_at      DateTime
  used_at         DateTime?
  revoked_at      DateTime?
  created_by      String
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([store_id])
  @@map("store_invites")
}

enum Permission {
  POS_ACCESS
  MANAGE_PRODUCTS
  MANAGE_INVENTORY
  VIEW_COST_PRICE
  VIEW_ANALYTICS
  VIEW_DASHBOARD
}

enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
}

enum Role {
  admin
  user
}
