{
  "name": "@bozorchi/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for Bozorchi apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/client": "^7.1.0"
  },
  "scripts": {
    "build": "tsc && cp -r src/generated dist/generated",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
