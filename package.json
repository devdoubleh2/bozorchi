{
  "name": "bozorchi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Bozorchi workspace monorepo",
  "workspaces": [
    "apps/*",
    "packages/@bozorchi/*"
  ],
  "scripts": {
    "build": "bun run --filter '@bozorchi/shared' build && bun run --filter '@bozorchi/api' build && bun run --filter '@bozorchi/web' build",
    "build:all": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "web": "cd apps/web && bun run dev",
    "api": "cd apps/api && bun run dev",
    "mobile": "bun run --filter '@bozorchi/mobile' start",
    "api:build": "bun run --filter '@bozorchi/api' build",
    "web:build": "bun run --filter '@bozorchi/web' build",
    "mobile:build": "bun run --filter '@bozorchi/mobile' build",
    "generate": "bun run --filter '@bozorchi/api' generate:all",
    "search-console": "bun scripts/search-console.mjs"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.9"
  },
  "dependencies": {
    "@babel/plugin-transform-typescript": "^7.28.6"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9"
  }
}
